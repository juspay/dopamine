.env
.env.*
!.env.example
__pycache__/
*.pyc
videos/*_saved/
videos/thumbnails/
videos/classified/
node_modules/
dist/
sandbox/
logs/
*.log
coverage/

# Secrets & credentials
*.pem
*.key
*.p12
service-account*.json
credentials*.json
node_modules_old
node_modules_broken/

# Use a single lockfile (npm). Do not commit the pnpm lockfile.
pnpm-lock.yaml

# ──────────────────────────────────────────────
# Retrieved third-party content & pipeline state — NEVER commit.
# Regenerated locally by the pipeline. Nothing under dashboard/data/ is tracked:
# `npm run dashboard:data` overwrites it with real scraped content, so tracking
# any of it puts a corpus one `git add -A` away from a public push.
# See dashboard/data/README.md.
# ──────────────────────────────────────────────
knowledge_base/
videos/*.json
videos/*.csv
videos/*.db
videos/*.db-*
/dashboard/data/*
!/dashboard/data/README.md

# Personal project portfolio for mapping (the .example.json is tracked).
projects.json

# Debug artifacts
dashboard-*.png
videos/*.backup.*
videos/*.bak
videos/*.bak.*
videos/smoke-test-*.json

# Claude Code harness artifacts (worktrees, etc.)
.claude/
